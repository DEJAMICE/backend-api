{
  "info": {
    "name": "SafeSignal API - Persona 2 (Auth, Users, Contacts, Devices)",
    "description": "Colección de pruebas del módulo base. Ejecutar primero 1. Auth > Login para obtener el token. Cambiar baseUrl si la API se despliega.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "contactId",
      "value": ""
    },
    {
      "key": "deviceId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Login (usuario demo)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@safesignal.pe\",\n  \"password\": \"Demo1234!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Guarda el accessToken en la variable {{token}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "const j = pm.response.json();",
                  "pm.test(\"Devuelve accessToken\", function(){ pm.expect(j.accessToken).to.be.a(\"string\").and.not.empty; });",
                  "pm.collectionVariables.set(\"token\", j.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register (nuevo usuario)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Mateo Salazar\",\n  \"email\": \"mateo.{{$timestamp}}@example.com\",\n  \"phoneNumber\": \"+51987654321\",\n  \"password\": \"Secreta123\",\n  \"profileType\": \"Student\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Email con timestamp para poder repetir la prueba. Guarda el token del nuevo usuario."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set(\"token\", j.accessToken);"
                ]
              }
            }
          ]
        },
